# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
backend/.venv/
.venv/
venv/

# Local SQLite fallback database (app/database.py drops to this when Postgres
# is unreachable and DEBUG=True). Never a source of truth.
*.db
*.sqlite3

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Logs and editor noise
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Secrets. backend/.env holds AIO_KEY, SECRET_KEY and the database password, so it is
# NOT committed. It used to be -- two real Adafruit keys reached pushed history that way
# (commits 565cf6f and a1f0fb1). Copy backend/.env.example and fill it in locally.
backend/.env
.env
!.env.example
!**/.env.example
