# Copy to `backend/.env` and fill in. That file is gitignored and must stay that way:
# it holds the Adafruit key, the JWT signing secret and the database password.

# --- Database ---
# Local docker-compose Postgres. On a hosted deployment set this in the platform's
# dashboard, never here. `postgres://` is normalized to `postgresql+psycopg2://`
# automatically, and sslmode=require is appended for non-local hosts.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tractor_dss

# --- Security ---
# Signs every JWT. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
DEBUG=True
LOG_LEVEL=INFO

# Local dev convenience only: lets the app run without Postgres/docker. Deployments must
# leave this False (see render.yaml) so an unreachable database fails loudly instead of
# booting on an empty, ephemeral SQLite file that looks healthy.
ALLOW_SQLITE_FALLBACK=True

# --- Adafruit IO ---
# Account username and key from io.adafruit.com -> My Key.
# Treat the key like a password: it grants full read/write on every feed in the account.
AIO_USERNAME=
AIO_KEY=

IOT_DEFAULT_DEVICE_ID=default
ENABLE_IOT_HTTP_POLLER=True
ENABLE_IOT_MQTT=True

# 8883 is Adafruit's TLS port. 1883 is plaintext and would send AIO_KEY in the clear.
IOT_MQTT_BROKER=io.adafruit.com
IOT_MQTT_PORT=8883
IOT_MQTT_TLS=True

# Poll cadence follows session state; MQTT is the hot path, the poller is backfill.
IOT_ACTIVE_POLL_INTERVAL_SEC=45
IOT_IDLE_POLL_INTERVAL_SEC=120
IOT_HTTP_POLL_LIMIT=5
IOT_BUFFER_MAX_ITEMS=20
IOT_BUFFER_MAX_AGE_SEC=4
